<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>app.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>
    <ItemGroup>
        <AvaloniaResource Include="app.ico"/>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2"/>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3"/>
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3"/>
        <!--Condition below is needed to remove DiagnosticsSupport package from build output in Release configuration.-->
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="FluentFTP" Version="55.0.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4"/>
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7"/>
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\external\ColekUI\src\ColekUI\ColekUI.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="App.axaml.cs">
            <DependentUpon>App.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Accounts\AccountsView.axaml.cs">
            <DependentUpon>AccountsView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Accounts\AddAccountWindow.axaml.cs">
            <DependentUpon>AddAccountWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Accounts\AddOfflineAccountWindow.axaml.cs">
            <DependentUpon>AddOfflineAccountWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Consoles\ConsolesView.axaml.cs">
            <DependentUpon>ConsolesView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Consoles\RegisterConsoleWindow.axaml.cs">
            <DependentUpon>RegisterConsoleWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Consoles\ConsoleSettingsWindow.axaml.cs">
            <DependentUpon>ConsoleSettingsWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Shell\MainWindow.axaml.cs">
            <DependentUpon>MainWindow.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Entitlements\EntitlementsView.axaml.cs">
            <DependentUpon>EntitlementsView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Backloggery\BackloggeryView.axaml.cs">
            <DependentUpon>BackloggeryView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Patches\PatchesView.axaml.cs">
            <DependentUpon>PatchesView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
        <Compile Update="Views\Settings\SettingsView.axaml.cs">
            <DependentUpon>SettingsView.axaml</DependentUpon>
            <SubType>Code</SubType>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Views\Accounts\AccountsView.axaml"/>
        <AdditionalFiles Include="Views\Backloggery\BackloggeryView.axaml"/>
        <AdditionalFiles Include="Views\Accounts\AddAccountWindow.axaml"/>
        <AdditionalFiles Include="Views\Accounts\AddOfflineAccountWindow.axaml"/>
        <AdditionalFiles Include="Views\Consoles\ConsolesView.axaml"/>
        <AdditionalFiles Include="Views\Consoles\RegisterConsoleWindow.axaml"/>
        <AdditionalFiles Include="Views\Consoles\ConsoleSettingsWindow.axaml"/>
        <AdditionalFiles Include="Views\Entitlements\EntitlementsView.axaml"/>
        <AdditionalFiles Include="Views\Shell\MainWindow.axaml"/>
        <AdditionalFiles Include="Views\Settings\SettingsView.axaml"/>
    </ItemGroup>
</Project>
