<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:models="clr-namespace:PSNav.Models.Shell"
             xmlns:conv="clr-namespace:PSNav.Converters"
             xmlns:shell="clr-namespace:PSNav.Views.Shell"
             xmlns:vm="clr-namespace:PSNav.ViewModels.Shell"

             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="720"

             x:Class="PSNav.Views.Shell.AppShell"
             x:DataType="vm:MainViewModel"
             Background="#FF0F0F0F">

    <UserControl.Resources>
        <conv:IconConverter x:Key="IconConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="48,*">
        <Border Grid.Row="0"
                Height="48"
                Background="#FF101010"
                PointerPressed="TitleBar_PointerPressed"
                DoubleTapped="TitleBar_DoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Margin="16,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=shell:AppShell}}" />
                <Panel Grid.Column="1" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="0,0,8,0">
                    <Button Width="40" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Minimize_Click">
                        <iconPacks:PackIconCodicons Kind="ChromeMinimize" Width="10" Height="10" />
                    </Button>
                    <Button Width="40" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="MaxRestore_Click">
                        <iconPacks:PackIconCodicons x:Name="MaxRestoreIcon" Kind="ChromeMaximize" Width="10"
                                                    Height="10" />
                    </Button>
                    <Button Width="40" Height="28"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Close_Click">
                        <iconPacks:PackIconCodicons Kind="ChromeClose" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="48,*">
            <Border Grid.Column="0"
                    Background="#FF101010"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="4">
                    <ListBox x:Name="BottomMenu"
                             DockPanel.Dock="Bottom"
                             Margin="0,6,0,0"
                             SelectionMode="Single"
                             ItemsSource="{Binding BottomMenuItems}"
                             SelectedItem="{Binding SelectedMenuItem}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="#FF1F1F1F" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#FF2A2A2A" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="BorderBrush" Value="#FF3A3A3A" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationItem">
                                <Panel ToolTip.Tip="{Binding ToolTip}">
                                    <ContentControl Content="{Binding Converter={StaticResource IconConverter}}" />
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="TopMenu"
                             SelectionMode="Single"
                             ItemsSource="{Binding MenuItems}"
                             SelectedItem="{Binding SelectedMenuItem}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="#FF1F1F1F" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#FF2A2A2A" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="BorderBrush" Value="#FF3A3A3A" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationItem">
                                <Panel ToolTip.Tip="{Binding ToolTip}">
                                    <ContentControl Content="{Binding Converter={StaticResource IconConverter}}" />
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </Border>
            <Border Grid.Column="1"
                    CornerRadius="16,0,0,0"
                    ClipToBounds="True">
                <Border.Background>
                    <RadialGradientBrush
                        GradientOrigin="50%, 0%"
                        Center="50%, 0%"
                        RadiusX="100%"
                        RadiusY="150%">
                        <GradientStop Color="#151934" Offset="0" />
                        <GradientStop Color="#050716" Offset="0.45" />
                        <GradientStop Color="#000000" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <ContentControl Content="{Binding CurrentPage}" Margin="20" />
            </Border>
        </Grid>
    </Grid>
</UserControl>