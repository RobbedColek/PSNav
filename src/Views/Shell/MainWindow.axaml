<colek:ColekWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:colek="https://github.com/RobbedColek/ColekUI"
                   xmlns:vm="clr-namespace:PSNav.ViewModels.Shell"

                   mc:Ignorable="d"
                   d:DesignWidth="1280"
                   d:DesignHeight="720"

                   x:Class="PSNav.Views.Shell.MainWindow"
                   x:DataType="vm:MainViewModel"
                   Title="PSN Account Vault"
                   MinWidth="770"
                   MinHeight="330"
                   Icon="/app.ico"

                   NavigationItems="{Binding Navigation.Items}"
                   FooterNavigationItems="{Binding Navigation.FooterItems}"
                   SelectedNavigationItem="{Binding Navigation.SelectedItem}"
                   Content="{Binding Navigation.CurrentPage}" />
