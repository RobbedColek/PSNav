<colek:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:colek="https://github.com/RobbedColek/ColekUI"
                    mc:Ignorable="d"
                    d:DesignWidth="500"
                    d:DesignHeight="250"
                    x:Class="PSNav.Views.Consoles.RegisterConsoleWindow"
                    Title="Register Console"
                    Header="Register Console"
                    Description="Enter a name and select the entitlement.db / entitlement4.db file."
                    Width="500"
                    MinWidth="500">

    <StackPanel Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Console Name"
                       FontSize="12"
                       Foreground="#FF9A9A9A" />
            <TextBox x:Name="ConsoleNameTextBox"
                     PlaceholderText="e.g. My PS4 Pro" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Entitlements Database File"
                       FontSize="12"
                       Foreground="#FF9A9A9A" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="FilePathTextBox"
                         IsReadOnly="True"
                         PlaceholderText="Select entitlement.db / entitlement4.db..." />
                <Button Grid.Column="1"
                        MinWidth="90"
                        Content="Browse..."
                        Click="Browse_Click" />
            </Grid>
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="#FFFF6B6B"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="False" />
    </StackPanel>

    <colek:DialogWindow.Buttons>
        <Button x:Name="RegisterButton"
                MinWidth="110"
                Content="Register"
                IsDefault="True"
                Click="Register_Click" />
        <Button MinWidth="90"
                Content="Cancel"
                IsCancel="True"
                Click="Cancel_Click" />
    </colek:DialogWindow.Buttons>
</colek:DialogWindow>
