<colek:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:colek="https://github.com/RobbedColek/ColekUI"
                    mc:Ignorable="d"
                    d:DesignWidth="400"
                    d:DesignHeight="180"
                    x:Class="PSNav.Views.Accounts.AddOfflineAccountWindow"
                    Title="Add Offline Account"
                    Header="Add offline account"
                    Description="Offline account can be used to link profiles from console without adding a real PlayStation Network account."
                    Width="640"
                    MinWidth="640">

    <StackPanel Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="Profile ID"
                       FontSize="12"
                       Foreground="#FF9A9A9A" />
            <TextBox x:Name="OnlineIdTextBox" />
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="#FFFF6B6B"
                   TextWrapping="Wrap"
                   IsVisible="False" />
    </StackPanel>

    <colek:DialogWindow.Buttons>
        <Button x:Name="AddButton"
                MinWidth="110"
                Content="Add account"
                IsDefault="True"
                Click="Add_Click" />
        <Button MinWidth="90"
                Content="Cancel"
                IsCancel="True"
                Click="Cancel_Click" />
    </colek:DialogWindow.Buttons>
</colek:DialogWindow>
