<colek:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:colek="https://github.com/RobbedColek/ColekUI"
                    mc:Ignorable="d"
                    d:DesignWidth="640"
                    x:Class="PSNav.Views.Accounts.AddAccountWindow"
                    Title="Add account"
                    Header="Add account"
                    Description="Open the following link in your browser while signed in to PlayStation Network, then paste the JSON output below."
                    Width="640">

    <StackPanel Spacing="8">
        <HyperlinkButton Content="https://ca.account.sony.com/api/v1/ssocookie"
                         NavigateUri="https://ca.account.sony.com/api/v1/ssocookie"
                         Padding="0"
                         Foreground="#FF64B5F6" />

        <TextBox x:Name="SsoCookieJsonTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 MinHeight="60"
                 MaxHeight="120"
                 PlaceholderText="{}{ &quot;npsso&quot;: &quot;&lt;NPSSO_TOKEN&gt;&quot;, &quot;expires_in&quot;: XXXXXX }" />

        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="#FFFF6B6B"
                   TextWrapping="Wrap"
                   IsVisible="False" />
    </StackPanel>

    <colek:DialogWindow.Buttons>
        <ProgressBar x:Name="AddAccountProgressBar"
                     Width="90"
                     Height="18"
                     VerticalAlignment="Center"
                     IsIndeterminate="True"
                     IsVisible="False" />

        <Button x:Name="AddAccountButton"
                MinWidth="110"
                Content="Add account"
                IsDefault="True"
                Click="Add_Click" />

        <Button x:Name="CancelButton"
                MinWidth="90"
                Content="Cancel"
                IsCancel="True"
                Click="Cancel_Click" />
    </colek:DialogWindow.Buttons>
</colek:DialogWindow>
